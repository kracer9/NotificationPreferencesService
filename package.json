{
  "name": "notification-preferences-service",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npm run ts src/main.ts",
    "watch": "npm run ts -- --watch src/main.ts",
    "db:init": "npm run ts src/init.db.ts",
    "db:migration:run": "typeorm-ts-node-esm migration:run -d ./src/repos/TypeORM/PostgresMigration.ts",
    "db:migration:revert": "typeorm-ts-node-esm migration:revert -d ./src/repos/TypeORM/PostgresMigration.ts",
    "ts": "node --no-warnings --loader ts-node/esm",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.0.3",
    "@types/reflect-metadata": "^0.0.5",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "luxon": "^3.7.2",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28",
    "yaml": "^2.9.0"
  }
}
